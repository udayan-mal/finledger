generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(uuid())
  name                String
  email               String              @unique
  passwordHash        String
  currencyPreference  String              @default("INR")
  timezone            String              @default("Asia/Kolkata")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  accounts            Account[]
  transactions        Transaction[]
  categories          Category[]
  stockTrades         StockTrade[]
  mutualFunds         MutualFund[]
  budgets             Budget[]
  recurringExpenses   RecurringExpense[]
  netWorthSnapshots   NetWorthSnapshot[]
  aiInsights          AiInsight[]
  goals               Goal[]
}

model Account {
  id           String        @id @default(uuid())
  userId       String
  type         String        @default("WALLET")
  name         String
  balancePaise Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@index([userId])
}

model Transaction {
  id           String             @id @default(uuid())
  userId       String
  accountId    String
  type         String             @default("EXPENSE")
  amountPaise  Int
  categoryId   String?
  description  String?
  note         String?
  receiptUrl   String?
  tags         String             @default("[]")
  date         DateTime
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  account      Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category     Category?          @relation(fields: [categoryId], references: [id])
  splits       TransactionSplit[]

  @@index([userId, date])
  @@index([accountId, date])
}

model TransactionSplit {
  id            String      @id @default(uuid())
  transactionId String
  categoryId    String
  amountPaise   Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category      Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}

model Category {
  id           String             @id @default(uuid())
  userId       String
  name         String
  icon         String?
  color        String?
  type         String             @default("EXPENSE")
  createdAt    DateTime           @default(now())
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  splits       TransactionSplit[]
  budget       Budget?

  @@index([userId, type])
}

model StockTrade {
  id                String   @id @default(uuid())
  userId            String
  symbol            String
  qty               Int      @default(0)
  pricePaise        Int      @default(0)
  investedPaise     Int      @default(0)
  brokeragePaise    Int      @default(0)
  sttPaise          Int      @default(0)
  exchangeFeePaise  Int      @default(0)
  sebiChargePaise   Int      @default(0)
  stampDutyPaise    Int      @default(0)
  gstPaise          Int      @default(0)
  totalChargesPaise Int      @default(0)
  tradeType         String   @default("BUY")
  platform          String   @default("Zerodha")
  netPnlPaise       Int      @default(0)
  date              DateTime
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, symbol])
}

model MutualFund {
  id             String   @id @default(uuid())
  userId         String
  fundName       String
  folio          String?
  units          Float
  navAtBuyPaise  Int
  sipAmountPaise Int?
  sipDate        Int?
  type           String   @default("SIP")
  date           DateTime
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Budget {
  id          String   @id @default(uuid())
  userId      String
  categoryId  String   @unique
  period      String
  amountPaise Int
  rollover    Boolean  @default(false)
  startDate   DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([userId, startDate])
}

model Goal {
  id                 String   @id @default(uuid())
  userId             String
  name               String
  targetAmountPaise  Int
  currentAmountPaise Int      @default(0)
  targetDate         DateTime
  createdAt          DateTime @default(now())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecurringExpense {
  id          String   @id @default(uuid())
  userId      String
  name        String
  amountPaise Int
  frequency   String
  nextDue     DateTime
  active      Boolean  @default(true)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, nextDue])
}

model NetWorthSnapshot {
  id                    String   @id @default(uuid())
  userId                String
  totalAssetsPaise      Int
  totalLiabilitiesPaise Int
  date                  DateTime
  createdAt             DateTime @default(now())
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model AiInsight {
  id          String   @id @default(uuid())
  userId      String
  insightText String
  type        String
  generatedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, generatedAt])
}
